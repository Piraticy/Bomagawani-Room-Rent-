NODE_ENV=development
PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=0
MAX_UPLOAD_SIZE_MB=25
DATA_DIR=./data
UPLOAD_ROOT_DIR=./public/uploads
CONTENT_SNAPSHOT_FILE=./data/content.snapshot.json
SESSION_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@bomagawani.com
ADMIN_PASSWORD=Admin@12345

# Database (libSQL/Turso). Leave unset for local dev and Docker/Render - it
# defaults to a local SQLite file at DATA_DIR/bomagawani.db, same as before.
# For a Vercel deployment, create a free database at https://turso.tech and
# set these to the values it gives you:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Uploads (Vercel Blob). Leave unset for local dev and Docker/Render - uploads
# are written to UPLOAD_ROOT_DIR on local disk, same as before. Required for
# Vercel, since its filesystem does not persist between requests/deploys.
# Create a Blob store in your Vercel project's Storage tab to get this token:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Optional: booking status emails (confirmed/cancelled/paid) are skipped
# with a log message until all of SMTP_HOST/SMTP_USER/SMTP_PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=stay@bomagawani.com
PUBLIC_BASE_URL=https://bomagawani.com
