NODE_ENV=development
PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=0
MAX_UPLOAD_SIZE_MB=25
DATA_DIR=./data
UPLOAD_ROOT_DIR=./public/uploads
CONTENT_SNAPSHOT_FILE=./data/content.snapshot.json
SESSION_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@bomagawani.com
ADMIN_PASSWORD=Admin@12345

# Optional: booking status emails (confirmed/cancelled/paid) are skipped
# with a log message until all of SMTP_HOST/SMTP_USER/SMTP_PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=stay@bomagawani.com
PUBLIC_BASE_URL=https://bomagawani.com
